# Global options
{
	# No need for the admin API in Railway's environment
	admin off
	# Storage isn't persistent anyway
	persist_config off
	# Railway terminates TLS at its edge, so Caddy only serves plain HTTP
	auto_https off

	log {
		format json
	}

	servers {
		# Trust Railway's proxy so client IPs are logged correctly
		trusted_proxies static private_ranges
	}
}

# Railway assigns $PORT, fall back to 8080 for local `docker run`
:{$PORT:8080} {
	log {
		format json
	}

	root * /srv
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Everything under /_astro has a content hash in its filename, cache forever
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (HTML, favicon, robots.txt) is revalidated so new deploys show up immediately
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	# Resolve clean URLs to Astro's generated HTML files
	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		# Don't let a missing hashed asset get cached as immutable
		header Cache-Control "public, max-age=0, must-revalidate"
		rewrite * /404.html
		file_server
	}
}
